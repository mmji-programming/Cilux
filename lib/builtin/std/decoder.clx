// std::decoder — Binary Decoders
//
// This module provides binary decoder circuits.
//
// Components:
//   decoder_1to2 — 1-to-2 decoder
//   decoder_2to4 — 2-to-4 decoder
//   decoder_3to8 — 3-to-8 decoder
//
// Truth Table (decoder_1to2):
//   en | in | y0 y1
//   0  |  x |  0  0
//   1  |  0 |  1  0
//   1  |  1 |  0  1
//
// Usage:
//   import std::decoder::decoder_2to4;
//   import std::decoder::*;
//
//   decoder_2to4 d;
//   r = d(in0=1, in1=0, en=1);
//   r.y0 — 0, r.y1 — 0, r.y2 — 1, r.y3 — 0

circuit decoder_1to2 {
    
    input in, en;
    output y[1:0];
    
    AND(in, en) -> y1;
    AND(NOT(in), en) -> y0;
}

circuit decoder_2to4 {

    input in[1:0], en;
    output y[3:0];
    
    decoder_1to2 d0, d1;
    
    r0 = d0(in=in0, en=en);
    r1 = d1(in=in0, en=en);
    
    AND(r0.y0, NOT(in1)) -> y0;
    AND(r0.y1, NOT(in1)) -> y1;
    AND(r1.y0, in1) -> y2;
    AND(r1.y1, in1) -> y3;
}

circuit decoder_3to8 {

    input in[2:0], en;
    output y[7:0];
    
    decoder_2to4 d_low, d_high;
    
    r_low = d_low(in0=in0, in1=in1, en=en);
    r_high = d_high(in0=in0, in1=in1, en=en);
    
    AND(r_low.y0, NOT(in2)) -> y0;
    AND(r_low.y1, NOT(in2)) -> y1;
    AND(r_low.y2, NOT(in2)) -> y2;
    AND(r_low.y3, NOT(in2)) -> y3;
    AND(r_high.y0, in2) -> y4;
    AND(r_high.y1, in2) -> y5;
    AND(r_high.y2, in2) -> y6;
    AND(r_high.y3, in2) -> y7;
}
